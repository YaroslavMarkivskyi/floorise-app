generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Auth.js required models ─────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime? @map("email_verified")
  image         String?
  passwordHash  String?   @map("password_hash")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  accounts      Account[]
  sessions      Session[]
  profile       Profile?
  mealSlots     MealSlot[]
  dishes        Dish[]
  mealLogs      MealLog[]
  shoppingLists ShoppingList[]
  weightEntries WeightEntry[]
  measurements  BodyMeasurement[]
  weeklyPlans   WeeklyPlan[]

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ─── App models ───────────────────────────────────────────────────────────────

model Profile {
  id             String   @id @default(cuid())
  userId         String   @unique @map("user_id")
  height         Int?
  age            Int?
  kcalFloor      Int?     @map("kcal_floor")
  kcalTarget     Int?     @map("kcal_target")
  timezone       String   @default("Europe/Kyiv")
  telegramChatId String?  @map("telegram_chat_id")
  telegramLinked Boolean  @default(false) @map("telegram_linked")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("profiles")
}

model MealSlot {
  id         String   @id @default(cuid())
  userId     String   @map("user_id")
  order      Int
  name       String
  time       String   // HH:MM
  targetKcal Int      @map("target_kcal")
  active     Boolean  @default(true)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  slotDishes    SlotDish[]
  mealLogs      MealLog[]
  plannedDishes PlannedDish[]

  @@map("meal_slots")
}

enum DishSource {
  seed
  ai
  manual
}

model Dish {
  id          String     @id @default(cuid())
  userId      String     @map("user_id")
  name        String
  kcal        Int
  cookTime    Int?       @map("cook_time")
  source      DishSource @default(manual)
  ingredients Json
  steps       Json
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  slotDishes SlotDish[]
  mealLogs   MealLog[]

  @@map("dishes")
}

model SlotDish {
  id       String @id @default(cuid())
  slotId   String @map("slot_id")
  dishId   String @map("dish_id")
  position Int

  slot MealSlot @relation(fields: [slotId], references: [id], onDelete: Cascade)
  dish Dish     @relation(fields: [dishId], references: [id], onDelete: Cascade)

  @@unique([slotId, position])
  @@map("slot_dishes")
}

model MealLog {
  id           String   @id @default(cuid())
  userId       String   @map("user_id")
  date         DateTime @db.Date
  slotId       String   @map("slot_id")
  chosenDishId String?  @map("chosen_dish_id")
  done         Boolean  @default(false)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  slot       MealSlot  @relation(fields: [slotId], references: [id], onDelete: Cascade)
  chosenDish Dish?     @relation(fields: [chosenDishId], references: [id], onDelete: SetNull)

  @@unique([userId, date, slotId])
  @@map("meal_logs")
}

enum ListStatus {
  active
  done
}

enum ItemSource {
  staple
  meal_sync
}

model ShoppingList {
  id        String     @id @default(cuid())
  userId    String     @map("user_id")
  weekStart DateTime   @db.Date @map("week_start")
  status    ListStatus @default(active)
  createdAt DateTime   @default(now()) @map("created_at")
  closedAt  DateTime?  @map("closed_at")

  user  User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  items ShoppingItem[]

  @@unique([userId, weekStart])
  @@map("shopping_lists")
}

model ShoppingItem {
  id       String     @id @default(cuid())
  listId   String     @map("list_id")
  name     String
  category String?
  qty      String?
  checked  Boolean    @default(false)
  source   ItemSource @default(staple)

  list ShoppingList @relation(fields: [listId], references: [id], onDelete: Cascade)

  @@map("shopping_items")
}

enum PlanStatus {
  draft
  approved
  archived
}

model WeeklyPlan {
  id        String     @id @default(cuid())
  userId    String     @map("user_id")
  weekStart DateTime   @db.Date
  status    PlanStatus @default(draft)
  userNotes String?    @map("user_notes") @db.Text
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")

  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  plannedDishes PlannedDish[]

  @@unique([userId, weekStart])
  @@map("weekly_plans")
}

model PlannedDish {
  id          String  @id @default(cuid())
  planId      String  @map("plan_id")
  slotId      String  @map("slot_id")
  dayOfWeek   Int     @map("day_of_week")
  name        String
  kcal        Int
  proteins    Int?
  fats        Int?
  carbs       Int?
  cookTime      Int?    @map("cook_time")
  portionWeight Int?    @map("portion_weight")
  ingredients   Json
  steps         Json

  plan WeeklyPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  slot MealSlot   @relation(fields: [slotId], references: [id], onDelete: Cascade)

  @@unique([planId, slotId, dayOfWeek])
  @@map("planned_dishes")
}

model WeightEntry {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  date      DateTime @db.Date
  kg        Decimal  @db.Decimal(5, 2)
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@map("weight_entries")
}

model BodyMeasurement {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  date      DateTime @db.Date
  bicep     Decimal? @db.Decimal(5, 1)
  chest     Decimal? @db.Decimal(5, 1)
  thigh     Decimal? @db.Decimal(5, 1)
  waist     Decimal? @db.Decimal(5, 1)
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@map("body_measurements")
}
